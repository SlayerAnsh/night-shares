# API runtime config for the Compose stack. Copy to .env (gitignored), or paste into the Dokploy Environment tab.
# PORT and DB_PATH are fixed by docker-compose.yml. Every other key in
# apps/api/.env.example is accepted here; this file lists the deployment ones.

ADAPTERS=mock
# Local demo only. Real presence requires platform provisioned NFC tags.
DEV_TAG_ISSUER=true
LOG_LEVEL=info

# Public HTTPS origin of the Dokploy domain, e.g. https://nightshares.example.com
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# World ID defaults to production in cloud mode; use staging explicitly for the simulator.
WORLD_ID_MODE=mock
WORLD_ID_APP_ID=
WORLD_ID_RP_ID=
WORLD_ID_SIGNING_KEY=
# Unset: production for cloud/world-id mode, staging for mock mode.
WORLD_ID_ENVIRONMENT=
WORLD_ID_ENROLL_ACTION=night-shares-enroll

# Wallet custody (mock or privy). Chain mode on testnet and mainnet uses privy.
WALLET_CUSTODY=mock
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=

# Required when ADAPTERS is not mock.
RECEPTION_TAG_SECRET=
# Replace for any shared deployment.
ORDER_MOCK_SECRET=change-me

# Chain mode. Leave ARC_NETWORK unset for mock settlement; set testnet or
# mainnet per Dokploy deployment. Run exactly one api replica: the SQLite
# volume holds the transaction journal and nonces. Keep that volume private,
# because the journal holds signed transactions.
# ARC_NETWORK=testnet
# Comma-separated Arc RPC URLs, first preferred. May contain an API key:
# set it as a secret, never commit it. Defaults to the network's public RPCs.
# Empty or whitespace-only values use the default RPCs.
# ARC_RPC_URLS=
# ARC_DEPLOYMENT_FILE defaults to packages/contracts/deployments/<chain id>.json.

# Chain signing keys. Choose exactly one source per role (ATTESTER, OPS);
# ambiguous or incomplete sources fail startup. Keychain (*_KEYCHAIN_SERVICE)
# is macOS only and does not work in Dokploy. Inject keys and passwords as
# secrets. Keystore files need a read-only mount into the api container.
#   <ROLE>_KEYSTORE + <ROLE>_KEYSTORE_PASSWORD
#   <ROLE>_KEYSTORE + <ROLE>_KEYSTORE_PASSWORD_FILE
#   <ROLE>_KEY (raw private key)
# Set only the chosen source; empty or whitespace-only values are ignored.
# ATTESTER_KEY=
# OPS_KEY=
# The ops wallet must hold native USDC before trading; /readyz (and so the
# web container, which waits for a healthy api) fails below this balance.
# CHAIN_OPS_MIN_BALANCE=0.1
# CHAIN_GAS_FLOAT=0.05
# CHAIN_GAS_LOW_WATER=0.01
# CHAIN_GAS_DAILY_CAP_PER_WALLET=0.2

# Agent Pass. OIDC needs the API callback reachable over public HTTPS.
AGENT_APPROVAL=agent-pass
AGENT_PASS_MODE=mock
AGENT_PASS_CLIENT_ID=
AGENT_PASS_CLIENT_SECRET=
AGENT_PASS_REDIRECT_URI=http://localhost:8787/agent-pass/callback
