{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!packages/proto/gen",
      "!!**/generated",
      "!!**/*.md",
      "!!**/dist",
      "!!**/.next",
      "!!**/coverage"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
