PORT=8787
DB_PATH=./data/night-shares.db
CLOCK=system
IDS=random
ADAPTERS=mock
# Local demo only. Real presence requires platform provisioned NFC tags.
DEV_TAG_ISSUER=true
# TODAY=2026-12-01

# Identity selection is independent of the mock wallet and chain adapters.
WORLD_ID_MODE=mock
WORLD_ID_APP_ID=
WORLD_ID_ENROLL_ACTION=night-shares-enroll
WORLD_ID_RP_ID=
WORLD_ID_SIGNING_KEY=
WORLD_ID_ENVIRONMENT=staging
WORLD_ID_ALLOW_LEGACY=true
WORLD_ID_DEVICE_CREDENTIAL=selfieCheck
WORLD_ID_VERIFY_URL=https://developer.world.org/api/v4/verify/{rp_id}

# HTTP operations. Limits are per API process.
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_IP=120
RATE_LIMIT_PER_USER=120
RATE_LIMIT_IDENTITY=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_BUCKETS=10000
MAX_REQUEST_BODY_BYTES=65536
CONNECT_READ_MAX_BYTES=65536
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# Forwarded IPs require TRUST_PROXY=true and an explicitly trusted socket peer.
# Empty TRUSTED_PROXIES trusts nobody, including loopback and private networks.
TRUSTED_PROXY_HOPS=1
TRUSTED_PROXIES=

# Required outside mock mode. Mock mode permits a fixed development default.
RECEPTION_TAG_SECRET=

# Wallet custody is independent of World ID authentication and mock settlement.
# Use WALLET_CUSTODY=anvil only with ARC_NETWORK=fork.
WALLET_CUSTODY=mock
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
ARC_NETWORK=mainnet
# ARC_RPC_URL defaults to the selected network RPC.
# ARC_RPC_URL=https://rpc.mainnet.arc.io

# EIP-712 domain defaults to the selected Arc network. Explicit overrides remain supported.
# ORDER_CHAIN_ID=5042
# ORDER_VERIFYING_CONTRACT=0x0000000000000000000000000000000000000000
ORDER_MOCK_SECRET=night-shares-dev-order-secret

# Agent Pass human checkpoints. Secrets remain on the API.
AGENT_APPROVAL=agent-pass
AGENT_PASS_MODE=mock
AGENT_PASS_ISSUER=https://auth.world.org
AGENT_PASS_CLIENT_ID=
AGENT_PASS_CLIENT_SECRET=
# OIDC mode requires the exact registered public HTTPS callback and HTTPS web origin.
AGENT_PASS_REDIRECT_URI=http://localhost:8787/agent-pass/callback
AGENT_PASS_ACR=https://world.org/oidc/acr/orb
WEB_ORIGIN=http://localhost:3000

# Local Arc mainnet fork. Leave these commented to retain mock development defaults.
# ARC_NETWORK=fork
# ARC_RPC_URL=http://127.0.0.1:8545
# ARC_DEPLOYMENT_FILE=packages/contracts/deployments/5042-fork.json
# CHAIN_STATUS=onchain
# WALLET_CUSTODY=anvil
FORK_FAUCET=false
# FORK_ATTESTER_KEY is supplied through the process environment, never committed.
# FORK_IT=1 enables the read-only live fork integration test.
