PORT=8787
DB_PATH=./data/night-shares.db
CLOCK=system
IDS=random
ADAPTERS=mock
# TODAY=2026-12-01

# Identity selection is independent of the mock wallet and chain adapters.
WORLD_ID_MODE=mock
WORLD_ID_APP_ID=
WORLD_ID_ACTION=night-shares-human
WORLD_ID_VERIFY_URL=https://developer.world.org/api/v2/verify/{app_id}

# HTTP operations. Limits are per API process.
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_IP=120
RATE_LIMIT_PER_USER=120
RATE_LIMIT_IDENTITY=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_BUCKETS=10000
MAX_REQUEST_BODY_BYTES=65536
CONNECT_READ_MAX_BYTES=65536
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# Forwarded IPs require TRUST_PROXY=true and an explicitly trusted socket peer.
# Empty TRUSTED_PROXIES trusts nobody, including loopback and private networks.
TRUSTED_PROXY_HOPS=1
TRUSTED_PROXIES=

# Required outside mock mode. Mock mode permits a fixed development default.
RECEPTION_TAG_SECRET=
